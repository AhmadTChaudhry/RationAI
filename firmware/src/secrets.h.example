// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored -- your WiFi password never leaves this machine.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// The Mac running server/usage_server.py, found over mDNS so a new DHCP lease
// doesn't need a reflash. This is `scutil --get LocalHostName`, without
// the ".local" suffix.
#define USAGE_HOST "your-macbook"
#define USAGE_PORT 8787

// Optional: used only if the mDNS lookup fails. Leave empty to skip.
#define USAGE_URL_FALLBACK ""
